{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
        window.addEventListener('DOMContentLoaded', () => {
            const navbar = document.getElementById('navbar');
            const buttonNav = document.getElementById('button_nav');
            console.log(buttonNav);
            buttonNav.classList.remove('rounded-b-full', 'rounded-tr-full');
            buttonNav.classList.add('rounded-md');
            const chiffresClesSection = document.getElementById('chiffres-cles');
            const chiffresClesSectionOffsetTop = chiffresClesSection.offsetTop;

        window.addEventListener('scroll', () => {
            const scrollY = window.scrollY || window.pageYOffset;
            if (scrollY > 50) {
                navbar.classList.remove('w-full', 'p-2', 'px-6');
                navbar.classList.add('w-3/4', 'mx-auto', 'mt-2', 'rounded-lg', 'shadow-lg', 'p-2',);
            } else {
                navbar.classList.remove('w-3/4', 'mx-auto', 'mt-2', 'shadow-lg', 'p-2');
                navbar.classList.add('w-full', 'p-2', 'px-6');
            }
            if (chiffresClesSectionOffsetTop < scrollY + window.innerHeight) {
                chiffresClesSection.classList.add('animate-fade-in-up');
            }
        });
    });
        </script>
{% endblock %}

