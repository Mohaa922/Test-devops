{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        let animationLaunched = false;

        window.addEventListener('scroll', () => {
            if (animationLaunched) return;

            const div = document.querySelector('#statistiques');
            if (!div) return;

            const rect = div.getBoundingClientRect();
            if (Math.trunc(rect.top) < window.innerHeight && Math.trunc(rect.bottom) >= 0) {
                animation();
                animationLaunched = true;
            }

        });

        document.querySelectorAll('a').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                animationLaunched = false;
            });
        });
        function animation() {
            let stats = document.querySelectorAll('.statistique');
            stats.forEach(stat => {
                let start_value = 0;
                let end_value = parseInt(stat.getAttribute('data-val'));
                let duration = Math.floor(3000 / end_value);

                let counter = setInterval(() => {
                    start_value += 1;
                    stat.textContent = start_value;
                    if (start_value >= end_value) {
                        stat.textContent = end_value;
                        clearInterval(counter);
                    }
                }, duration);
            });
        }
    });
        </script>
