# App
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=change_me_in_local_only
DEFAULT_URI=http://localhost:8081

# DB
MYSQL_DATABASE=symfony
MYSQL_USER=symfony
MYSQL_PASSWORD=symfony
MYSQL_ROOT_PASSWORD=rootpass
DATABASE_URL=mysql://symfony:symfony@mysql:3306/symfony?serverVersion=8.4.7&charset=utf8mb4

# Ports
HTTP_PORT=8081
PHPMYADMIN_PORT=8082

# Pour tailwind: forcer le binaire Linux
TAILWINDCSS_PLATFORM=linux-x64